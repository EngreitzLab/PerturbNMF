# Large reference data (3.3GB — not tracked in git)
# Run setup_resources.sh or manually symlink to populate
src/Stage2_Evaluation/Resources/

# Test output (generated)
tests/output/
tests/tests/output/
tests/resources/
tests/developing_test/

# Example output (generated)
examples/**/example_output/
examples/**/data/

# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Secrets / API keys
.env

# OS
.DS_Store

# Private working notes / session handoffs (never commit to this public repo)
tasks/
.baton/

# Claude skill eval/workspace artifacts (study-specific; keep in a private repo)
.claude/skills/*-workspace/
.claude/skills/*_output/

# Docs build output and pages generated from READMEs/notebooks by docs/conf.py
docs/_build/
docs/guide/*
!docs/guide/index.md
!docs/guide/hpc.md
!docs/guide/data_format.md
!docs/guide/workflow.md
!docs/guide/choosing_k.md
